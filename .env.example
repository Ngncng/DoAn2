# ================================
# HUNGDAO_CHATBOT - Cấu hình môi trường
# Sao chép file này thành .env
# rồi điền thông tin thật vào
# ================================

# --- Groq API ---
# Lấy tại: https://console.groq.com
GROQ_API_KEY=gsk_your_api_key_here_or_leave_blank
GROQ_MODEL=llama-3.3-70b-versatile

# --- SQL Server ---
# Tên server (thường là localhost hoặc .\SQLEXPRESS)
DB_SERVER=localhost
DB_NAME=HUNGDAO_CHATBOT
# Để trống nếu dùng Windows Authentication
DB_USER=SA
DB_PASSWORD=123456

# --- App Config ---
APP_HOST=127.0.0.1
APP_PORT=8000
DEBUG=True

# --- Upload ---
# Thư mục lưu file upload
UPLOAD_DIR=uploads
# Dung lượng tối đa (MB)
MAX_FILE_SIZE_MB=50

# --- RAG Config ---
# Số lượng chunk lấy ra khi tìm kiếm
TOP_K_CHUNKS=5
# Độ tương đồng tối thiểu (0.0 - 1.0)
MIN_SIMILARITY_SCORE=0.3

# --- Chunking ---
CHUNK_SIZE=500
CHUNK_OVERLAP=50